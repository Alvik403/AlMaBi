.env
.env.*
!.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*secret*
**/*credential*
ops/tls/

# Development-only content.
tests/
scripts/*
!scripts/manage_users.py
!scripts/cleanup_runtime.py
!scripts/migrate_legacy_uploads.py
docs/
*.log
docker-compose*.yml
