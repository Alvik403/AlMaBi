DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
AUTH_ENABLED=true
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_HTTPS_ONLY=true
SESSION_MAX_AGE_SECONDS=28800
AUTH_DB=runtime/auth.sqlite3
ALLOWED_HOSTS=almabi.internal.example
MAX_UPLOAD_BYTES=52428800
UPLOAD_QUOTA_BYTES=524288000
AUDIT_DETAIL_ENABLED=false
UPLOAD_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30

UPLOADS_DIR=uploads
RUNTIME_DIR=runtime
LOGS_DIR=logs
# false — only stdout (useful when ./logs bind-mount is not writable in Docker on Windows)
LOG_TO_FILES=true
