DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
AUTH_ENABLED=true
SESSION_SECRET=replace-with-at-least-32-random-characters
# Production reads secrets from files, not from this variable:
# SESSION_SECRET_FILE=/run/secrets/session_secret
# DATA_KEY_FILE=/run/secrets/data_key
SESSION_HTTPS_ONLY=true
SESSION_MAX_AGE_SECONDS=28800
SESSION_IDLE_SECONDS=900
SECRET_MAX_AGE_DAYS=60
AUTH_DB=runtime/auth.sqlite3
# Допустима только Keycloak 26.5.
# В production адрес, клиент и redirect подставляются из ALMABI_HOST.
# Эти строки нужны только для внешнего Keycloak вместо встроенного.
# KEYCLOAK_ISSUER=https://keycloak.example/realms/alabuga
# KEYCLOAK_CLIENT_ID=almabi
# KEYCLOAK_CLIENT_SECRET=replace-with-client-secret
# KEYCLOAK_REDIRECT_URI=https://almabi.internal.example/login/callback
# Тестовый стенд без AD: docker compose -f docker-compose.test.yml up --build
# KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/almabi-test
# Журналы: srv-s.alabuga.ru (10.50.53.121) TCP/1514 и TCP/1515
UPLOAD_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30
RETENTION_INTERVAL_DAYS=10
ALLOWED_HOSTS=almabi.internal.example
MAX_UPLOAD_BYTES=52428800
UPLOAD_QUOTA_BYTES=524288000
REQUEST_TIMEOUT_SECONDS=900
UVICORN_WORKERS=1
DASHBOARD_CACHE_MAX_ENTRIES=8
DASHBOARD_SKIP_DEEP_COPY=true
PIPELINE_SKIP_AUDIT_WHEN_DISABLED=true
PERF_LOG_ENABLED=false
AUDIT_DETAIL_ENABLED=false

UPLOADS_DIR=uploads
RUNTIME_DIR=runtime
LOGS_DIR=logs
# false — only stdout (useful when ./logs bind-mount is not writable in Docker on Windows)
LOG_TO_FILES=true
